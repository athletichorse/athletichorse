# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# One-time secret typed on /setup to create the first owner. Remove after setup.
SETUP_SECRET=choose-a-long-random-string
# Random string (≥16 chars). Vercel sends it to /api/cron/shopify-sync for the daily website sync.
CRON_SECRET=choose-another-long-random-string
# Other brand names (comma-separated) that the product upload replaces with our brand. Keep it private.
BRAND_REPLACE=
# Website orders (Shopify Dev Dashboard app on the store, client-credentials grant). Keep the secret private.
SHOPIFY_STORE=sfypqe-qu.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
