{
  "name": "store-portal-desktop",
  "productName": "Store Portal",
  "version": "1.0.0",
  "private": true,
  "description": "Windows app for the staff portal and cashier (works offline like the browser till).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.store.portal",
    "productName": "Store Portal",
    "files": ["main.js", "icon.png"],
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  }
}
