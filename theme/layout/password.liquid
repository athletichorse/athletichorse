<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{{ shop.name }}</title>
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}
  {{ content_for_header }}
  <style>
    @font-face { font-family: "Readex Pro"; src: url("{{ 'readex-arabic.woff2' | asset_url }}") format("woff2"); font-weight: 160 700; font-display: swap; unicode-range: U+0600-06FF, U+FB50-FDFF, U+FE70-FEFC; }
    @font-face { font-family: "Readex Pro"; src: url("{{ 'readex-latin.woff2' | asset_url }}") format("woff2"); font-weight: 160 700; font-display: swap; unicode-range: U+0000-00FF, U+2000-206F; }
    :root {
      --color-accent: {{ settings.color_accent }};
      --font-display: "Readex Pro", system-ui, sans-serif;
      --font-body: "Readex Pro", system-ui, sans-serif;
      --font-ar: "Readex Pro", Tahoma, sans-serif;
    }
    .ah-pw { min-height: 100svh; display: grid; place-items: center; padding: 24px; background: var(--dark); color: #C9D1CC; text-align: center; }
    .ah-pw__inner { display: grid; gap: 24px; justify-items: center; max-width: 480px; }
    .ah-pw .logo img { filter: brightness(0) invert(1); max-height: 56px; width: auto; }
    .ah-pw h1 { color: #fff; }
    .ah-pw form { display: flex; gap: 8px; width: 100%; }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>
<body>
  <main class="ah-pw">
    <div class="ah-pw__inner">
      {%- render 'logo' -%}
      <h1 class="ah-h1">{{ 'general.password_page.heading' | t }}</h1>
      {%- form 'storefront_password' -%}
        <label class="visually-hidden" for="Password">{{ 'general.password_page.password' | t }}</label>
        <input class="ah-input" type="password" id="Password" name="password" placeholder="{{ 'general.password_page.password' | t }}" required>
        <button type="submit" class="ah-btn ah-btn--highlight">{{ 'general.password_page.enter' | t }}</button>
        {%- if form.errors -%}<p class="ah-alert ah-alert--error" style="flex-basis:100%">{{ form.errors.messages['form'] }}</p>{%- endif -%}
      {%- endform -%}
      {{ content_for_layout }}
    </div>
  </main>
</body>
</html>
