{%- comment -%} Site logo. Accepts: css_class (optional) {%- endcomment -%}
<a href="{{ routes.root_url }}" class="logo{% if css_class %} {{ css_class }}{% endif %}" aria-label="{{ shop.name }}">
  {%- if settings.logo != blank -%}
    {%- assign logo_w = settings.logo_width | default: 180 -%}
    {%- assign logo_h = logo_w | divided_by: settings.logo.aspect_ratio | round -%}
    {%- assign logo_w2 = logo_w | times: 2 -%}
    {{ settings.logo | image_url: width: logo_w2 | image_tag:
      width: logo_w,
      height: logo_h,
      widths: '200,300,400,500',
      sizes: '200px',
      alt: shop.name,
      loading: 'eager'
    }}
  {%- else -%}
    {{ shop.name }}
  {%- endif -%}
</a>
