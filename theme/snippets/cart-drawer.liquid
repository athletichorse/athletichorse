{%- comment -%}
  Slide-out cart. Lines are rendered client-side from /cart.js by app.js so the
  drawer updates instantly; Liquid only supplies the shell and translated strings.
{%- endcomment -%}
<div class="drawer-overlay ah-cart-overlay" data-cart-overlay></div>
<aside class="ah-cart-drawer" data-cart-drawer aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle"
  data-free-shipping="{{ settings.free_shipping_threshold | default: 0 }}"
  data-str-ship-remaining="{{ 'sections.cart.shipping_remaining' | t | escape }}"
  data-str-ship-done="{{ 'sections.cart.shipping_done' | t | escape }}"
  data-str-empty="{{ 'sections.cart.empty' | t | escape }}"
  data-str-continue="{{ 'sections.cart.continue_shopping' | t | escape }}"
  data-str-remove="{{ 'sections.cart.remove' | t | escape }}"
  data-str-total="{{ 'sections.cart.total' | t | escape }}"
  data-str-qty="{{ 'sections.cart.quantity' | t | escape }}"
  data-str-coupon-empty="{{ 'sections.cart.empty_coupon' | t | escape }}"
  data-all-url="{{ routes.all_products_collection_url }}">
  <div class="ah-cart-drawer__head">
    <h2 id="CartDrawerTitle">{{ 'sections.cart.title' | t }} <span data-cart-title-count></span></h2>
    <button type="button" class="ah-icon-btn" data-cart-close aria-label="{{ 'general.header.close' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="ah-ship" data-cart-ship hidden></div>
  <div class="ah-cart-drawer__body" data-cart-body></div>
  <div class="ah-cart-drawer__foot" data-cart-foot hidden>
    <form class="ah-coupon" data-coupon>
      <label class="visually-hidden" for="CartDrawerCoupon">{{ 'sections.cart.coupon_placeholder' | t }}</label>
      <input id="CartDrawerCoupon" type="text" class="ah-input" placeholder="{{ 'sections.cart.coupon_placeholder' | t }}" autocomplete="off">
      <button type="submit" class="ah-btn ah-btn--outline">{{ 'sections.cart.apply' | t }}</button>
    </form>
    <p class="ah-coupon__msg" data-coupon-msg></p>
    <div class="ah-totals" data-cart-totals></div>
    <p class="ah-pay-note">{{ 'sections.cart.taxes_note' | t }}</p>
    <a href="/checkout" class="ah-btn ah-btn--brand ah-btn--lg ah-btn--block">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="4" y="10" width="16" height="11" rx="2"/><path stroke-linecap="round" d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
      {{ 'sections.cart.checkout' | t }}
    </a>
    <a href="{{ routes.cart_url }}" class="ah-link-arrow" style="justify-self:center">{{ 'sections.cart.view_cart' | t }}</a>
  </div>
</aside>
