{%- comment -%}
  Accepts:
    class            (optional) - wrapper <div> class. If blank, icons are output with no wrapper.
    item_class       (optional) - class applied to each <a> icon.
    include_whatsapp (optional bool, default true)
{%- endcomment -%}
{%- assign show_whatsapp = true -%}
{%- if include_whatsapp == false -%}{%- assign show_whatsapp = false -%}{%- endif -%}

{%- capture icons -%}
  {%- if settings.social_instagram_link != blank -%}
    <a href="{{ settings.social_instagram_link }}" class="{{ item_class }}" aria-label="Instagram" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>
  {%- endif -%}
  {%- if settings.social_facebook_link != blank -%}
    <a href="{{ settings.social_facebook_link }}" class="{{ item_class }}" aria-label="Facebook" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M15 8h-2a2 2 0 0 0-2 2v10M8 13h5"/><circle cx="12" cy="12" r="9"/></svg></a>
  {%- endif -%}
  {%- if settings.social_x_link != blank -%}
    <a href="{{ settings.social_x_link }}" class="{{ item_class }}" aria-label="X" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4l16 16M20 4 4 20"/></svg></a>
  {%- endif -%}
  {%- if settings.social_tiktok_link != blank -%}
    <a href="{{ settings.social_tiktok_link }}" class="{{ item_class }}" aria-label="TikTok" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M15 4v9.5a3.5 3.5 0 1 1-3-3.46M15 4a4 4 0 0 0 4 4"/></svg></a>
  {%- endif -%}
  {%- if settings.social_snapchat_link != blank -%}
    <a href="{{ settings.social_snapchat_link }}" class="{{ item_class }}" aria-label="Snapchat" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.5 0 4.5 2 4.5 4.5 0 1.2 0 2.3.3 3 .3.6 1 .9 1.7 1.1.4.1.5.6.2.9-.4.4-1 .7-1.7.9 0 .4.1.8-.2 1.1-.3.3-1 .3-1.5.3-.4.7-1.2 1.7-3.3 1.7s-2.9-1-3.3-1.7c-.5 0-1.2 0-1.5-.3-.3-.3-.2-.7-.2-1.1-.7-.2-1.3-.5-1.7-.9-.3-.3-.2-.8.2-.9.7-.2 1.4-.5 1.7-1.1.3-.7.3-1.8.3-3C7.5 5 9.5 3 12 3Z"/></svg></a>
  {%- endif -%}
  {%- if show_whatsapp and settings.social_whatsapp_number != blank -%}
    <a href="https://wa.me/{{ settings.social_whatsapp_number }}" class="{{ item_class }}" aria-label="WhatsApp" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M4 20l1.3-4A8 8 0 1 1 9 19.6L4 20Z"/></svg></a>
  {%- endif -%}
  {%- if settings.social_linktree_link != blank -%}
    <a href="{{ settings.social_linktree_link }}" class="{{ item_class }}" aria-label="{{ 'sections.contact.follow' | t }}" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M10 13a5 5 0 0 0 7.5.5l2-2a5 5 0 0 0-7-7l-1.5 1.5"/><path stroke-linecap="round" stroke-linejoin="round" d="M14 11a5 5 0 0 0-7.5-.5l-2 2a5 5 0 0 0 7 7l1.5-1.5"/></svg></a>
  {%- endif -%}
{%- endcapture -%}

{%- if icons != blank -%}
  {%- if class != blank -%}
    <div class="{{ class }}">{{ icons }}</div>
  {%- else -%}
    {{ icons }}
  {%- endif -%}
{%- endif -%}
