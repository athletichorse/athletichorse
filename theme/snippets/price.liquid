{%- comment -%}
  Price. Accepts: product (required), variant (optional), show_off (optional bool)
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product
  assign price = target.price
  assign compare = target.compare_at_price
  if variant == blank
    assign compare = product.compare_at_price
  endif
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
-%}
<div class="ah-price{% if on_sale %} ah-price--sale{% endif %}"{% if data_attr %} data-price{% endif %}>
  {%- if variant == blank and product.price_varies -%}
    {%- assign min_price = product.price_min | money_without_trailing_zeros -%}
    <span class="ah-price__now">{{ 'sections.product.from_price' | t: price: min_price }}</span>
  {%- else -%}
    <span class="ah-price__now">{{ price | money_without_trailing_zeros }}</span>
  {%- endif -%}
  {%- if on_sale -%}
    <s class="ah-price__was"><span class="visually-hidden">{{ 'sections.product.regular_price' | t }}</span>{{ compare | money_without_trailing_zeros }}</s>
    {%- if show_off -%}
      {%- assign off = compare | minus: price | times: 100.0 | divided_by: compare | round -%}
      <span class="ah-price__off">−{{ off }}%</span>
    {%- endif -%}
  {%- endif -%}
</div>
