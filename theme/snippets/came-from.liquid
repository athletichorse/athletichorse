{%- comment -%}
  "How did you hear about us?" — saved as the cart attribute "Came from", which shows on the order
  in Shopify admin. Values stay in English so reports group cleanly in both languages.
  Accepts: id_prefix (string, unique per page)
{%- endcomment -%}
{%- assign current = cart.attributes['Came from'] -%}
{%- assign sources = 'Google,ChatGPT / AI,Instagram,TikTok,Snapchat,Facebook,WhatsApp,Friend or family,Visited our store,Other' | split: ',' -%}
<fieldset class="ah-camefrom" data-came-from>
  <legend>{{ 'sections.cart.came_from' | t }} <span class="ah-camefrom__req" aria-hidden="true">*</span></legend>
  <div class="ah-camefrom__chips">
    {%- for src in sources -%}
      {%- assign key = src | handleize | replace: '-', '_' -%}
      <label class="ah-camefrom__chip">
        <input type="radio" name="attributes[Came from]" value="{{ src }}" id="{{ id_prefix }}-{{ key }}" {% if current == src %}checked{% endif %} required>
        <span>{{ 'sections.cart.came_from_' | append: key | t }}</span>
      </label>
    {%- endfor -%}
  </div>
  <p class="ah-camefrom__error" data-came-from-error hidden>{{ 'sections.cart.came_from_required' | t }}</p>
</fieldset>
