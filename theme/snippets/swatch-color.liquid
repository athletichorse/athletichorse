{%- comment -%}
  Accepts: value (a variant option value string, e.g. "Navy Blue" or "كحلي")
  Maps common color-option words (English and Arabic) to a real CSS color for swatch rendering.
{%- endcomment -%}
{%- assign v = value | downcase | strip -%}
{%- case v -%}
  {%- when 'black', 'أسود' -%}#111111
  {%- when 'white', 'أبيض' -%}#ffffff
  {%- when 'gray', 'grey', 'رمادي' -%}#9a9a9a
  {%- when 'dark gray', 'dark grey', 'charcoal', 'رمادي غامق', 'رمادي داكن' -%}#3f3f3f
  {%- when 'navy', 'navy blue', 'كحلي', 'أزرق كحلي' -%}#1c2b4a
  {%- when 'blue', 'أزرق' -%}#2f6fd1
  {%- when 'light blue', 'sky blue', 'baby blue', 'أزرق فاتح', 'أزرق سماوي', 'أزرق بيبي' -%}#7fb8e6
  {%- when 'red', 'أحمر' -%}#c0392b
  {%- when 'burgundy', 'maroon', 'wine', 'عنابي', 'خمري' -%}#6d1b2f
  {%- when 'orange', 'برتقالي' -%}#e07b28
  {%- when 'yellow', 'أصفر' -%}#f0c419
  {%- when 'green', 'أخضر' -%}#2f7d3c
  {%- when 'olive green', 'olive', 'زيتوني' -%}#6b7a3a
  {%- when 'pink', 'وردي', 'زهري' -%}#e78bb0
  {%- when 'fuchsia', 'فوشيا' -%}#c2185b
  {%- when 'mint', 'mint green', 'نعناعي' -%}#8fd4b8
  {%- when 'purple', 'بنفسجي' -%}#7c4fa0
  {%- when 'rose gold', 'ذهبي وردي' -%}#b76e79
  {%- when 'brown', 'بني' -%}#7a4b2a
  {%- when 'beige', 'بيج' -%}#e3d6bd
  {%- when 'gold', 'ذهبي' -%}#c9a94a
  {%- when 'silver', 'فضي' -%}#c4c4c4
  {%- when 'multicolor', 'multi', 'multi color', 'متعدد الألوان', 'ملون' -%}linear-gradient(135deg, #e0403b 0%, #f0c419 33%, #2f6fd1 66%, #2f7d3c 100%)
  {%- else -%}#b9b9b9
{%- endcase -%}
