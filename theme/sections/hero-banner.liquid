{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.hero_banner.heading' | t
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'sections.hero_banner.text' | t
  endif
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.hero_banner.eyebrow' | t
  endif
  assign cta_1 = section.settings.button_label_1
  if cta_1 == blank
    assign cta_1 = 'sections.hero_banner.cta_primary' | t
  endif
  assign cta_2 = section.settings.button_label_2
  if cta_2 == blank
    assign cta_2 = 'sections.hero_banner.cta_secondary' | t
  endif
  assign mobile_image = section.settings.image_mobile | default: section.settings.image
  assign hero_alt = section.settings.image.alt | default: heading
-%}

<section class="ah-hero ah-hero--{{ section.settings.align }}" style="--hero-min-h: {{ section.settings.height }}vh;">
  <div class="ah-hero__media">
    {%- if section.settings.image != blank -%}
      <picture>
        <source media="(min-width: 750px)" srcset="
          {{ section.settings.image | image_url: width: 1100 }} 1100w,
          {{ section.settings.image | image_url: width: 1500 }} 1500w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w"
          sizes="100vw">
        {{ mobile_image | image_url: width: 900 | image_tag:
          widths: '450,600,750,900',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: hero_alt,
          class: 'ah-hero__img'
        }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'ah-hero__img placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="container ah-hero__content">
    <div class="ah-hero__copy">
      <span class="ah-eyebrow ah-eyebrow--light">{{ eyebrow }}</span>
      {%- if section.settings.use_h1 -%}
        <h1 class="ah-hero__heading">{{ heading }}</h1>
      {%- else -%}
        <h2 class="ah-hero__heading">{{ heading }}</h2>
      {%- endif -%}
      <p class="ah-hero__text">{{ text }}</p>
      <div class="ah-hero__ctas">
        <a href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}" class="ah-btn ah-btn--highlight ah-btn--lg">{{ cta_1 }}</a>
        {%- if section.settings.button_link_2 != blank -%}
          <a href="{{ section.settings.button_link_2 }}" class="ah-btn ah-btn--ghost-light ah-btn--lg">{{ cta_2 }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "class": "ah-section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (desktop)", "info": "Landscape, at least 2000px wide." },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)", "info": "Optional portrait crop. Falls back to the desktop image." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Leave blank to use the translated default." },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the translated default." },
    { "type": "textarea", "id": "text", "label": "Text", "info": "Leave blank to use the translated default." },
    { "type": "checkbox", "id": "use_h1", "label": "Use as page H1", "default": true, "info": "Keep on for the homepage hero (SEO)." },
    { "type": "text", "id": "button_label_1", "label": "Primary button label" },
    { "type": "url", "id": "button_link_1", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    {
      "type": "select", "id": "align", "label": "Content position",
      "options": [
        { "value": "start", "label": "Start (left in English, right in Arabic)" },
        { "value": "center", "label": "Center" }
      ],
      "default": "start"
    },
    { "type": "range", "id": "height", "label": "Height on desktop", "min": 50, "max": 90, "step": 5, "unit": "vh", "default": 75 }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
