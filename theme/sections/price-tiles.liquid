<section class="ah-section ah-section--tight">
  <div class="container">
    <div class="ah-section__head">
      <div>
        <h2 class="ah-section__title">{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'sections.price_tiles.heading' | t }}{% endif %}</h2>
        <p class="ah-section__desc">{{ 'sections.price_tiles.text' | t }}</p>
      </div>
    </div>
    <ul class="ah-prices" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign amount = block.settings.amount
          assign base = section.settings.collection.url | default: routes.all_products_collection_url
          assign href = base | append: '?filter.v.price.lte=' | append: amount | append: '&sort_by=price-descending'
        -%}
        <li {{ block.shopify_attributes }}>
          <a class="ah-price-tile ah-price-tile--{{ forloop.index | modulo: 3 }}" href="{{ href }}">
            <span class="ah-price-tile__under">{{ 'sections.price_tiles.under' | t }}</span>
            <span class="ah-price-tile__amount">{{ amount }}</span>
            <span class="ah-price-tile__cur">{%- render 'riyal' -%}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Shop by price",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the translated default." },
    { "type": "collection", "id": "collection", "label": "Collection to filter", "info": "Defaults to all products. Price filter must be enabled in Search & Discovery." }
  ],
  "blocks": [
    { "type": "tier", "name": "Price tier", "settings": [{ "type": "number", "id": "amount", "label": "Max price (SAR)", "default": 50 }] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Shop by price", "blocks": [{ "type": "tier" }] }]
}
{% endschema %}
