<section class="ah-section">
  <div class="container">
    <div class="ah-section__head">
      <div>
        <h2 class="ah-section__title">{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'sections.department_tiles.heading' | t }}{% endif %}</h2>
      </div>
    </div>
    <div class="ah-depts" style="--cols: {{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = collections[block.settings.collection]
          assign tile_image = block.settings.image | default: coll.image | default: coll.products.first.featured_image
          assign tile_label = block.settings.label | default: coll.title
        -%}
        {%- if coll -%}
          <a href="{{ coll.url }}" class="ah-dept" {{ block.shopify_attributes }}>
            {%- if tile_image -%}
              {{ tile_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 750px) 33vw, 78vw', alt: tile_label }}
            {%- endif -%}
            <span class="ah-dept__body">
              <span>
                <span class="ah-dept__name">{{ tile_label }}</span>
                <span class="ah-dept__count">{{ 'sections.department_tiles.products' | t: count: coll.all_products_count }}</span>
              </span>
              <span class="ah-dept__arrow" aria-hidden="true">{%- render 'icon', name: 'arrow' -%}</span>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Department tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the translated default." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Department",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait lifestyle photo. Falls back to the collection image." },
        { "type": "text", "id": "label", "label": "Custom label", "info": "Leave blank to use the collection title." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Department tiles", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }
  ]
}
{% endschema %}
