{%- comment -%}
  11.11 Mega Sale: hero with countdown, plus two rails from one collection —
  "Biggest discounts" (highest % off first) and "Lowest prices" (cheapest first).
  Shows only between start_ts and end_ts (Unix seconds). Countdown JS hides it at the end too,
  in case a cached page is served after the sale.
{%- endcomment -%}
{%- liquid
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign start_ts = section.settings.start_ts | plus: 0
  assign end_ts = section.settings.end_ts | plus: 0
  assign live = false
  if now_ts >= start_ts and now_ts < end_ts
    assign live = true
  endif
  if request.design_mode
    assign live = true
  endif
  assign coll = collections[section.settings.collection]
-%}
{%- if live and coll and coll.products_count > 0 -%}
{%- liquid
  comment
    The collection is sorted manually, highest discount first, so the top in-stock product carries the headline discount.
  endcomment
  assign max_off = 0
  for p in coll.products limit: 100
    if p.available and p.compare_at_price > p.price
      assign p_off = p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price | round
      if p_off > max_off
        assign max_off = p_off
      endif
    endif
  endfor
  assign shop_url = coll.url
  assign cheap_url = coll.url | append: '?sort_by=price-ascending'
  comment
    With the rails on this page, the banner buttons jump to them instead of leaving the page.
  endcomment
  assign jump_discount = shop_url
  assign jump_cheapest = cheap_url
  if section.settings.show_rails
    assign jump_discount = '#ah-1111-discounts-' | append: section.id
    assign jump_cheapest = '#ah-1111-cheapest-' | append: section.id
  endif
-%}
<section class="ah-1111" data-ah-mega data-end="{{ end_ts }}">
  {%- if section.settings.show_hero -%}
  {%- liquid
    assign picks = ''
    assign pick_count = 0
    for p in coll.products limit: 50
      if pick_count < 4 and p.available and p.featured_image and p.compare_at_price > p.price
        assign p_off = p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price | round
        if p_off >= 35
          assign picks = picks | append: p.handle | append: ','
          assign pick_count = pick_count | plus: 1
        endif
      endif
    endfor
    assign pick_handles = picks | split: ','
  -%}
  <div class="ah-1111__hero ah-wf">
    <div class="ah-wf__shapes" aria-hidden="true">
      <span class="ah-wf__orb ah-wf__orb--1"></span>
      <span class="ah-wf__orb ah-wf__orb--2"></span>
      <span class="ah-wf__ring"></span>
      <span class="ah-wf__dots"></span>
      <span class="ah-wf__float ah-wf__float--1">{%- render 'icon', name: 'sale' -%}</span>
      <span class="ah-wf__float ah-wf__float--2">{%- render 'icon', name: 'truck' -%}</span>
      <span class="ah-wf__float ah-wf__float--3"><b>%</b></span>
      <span class="ah-wf__float ah-wf__float--4">{%- render 'icon', name: 'cash' -%}</span>
      <span class="ah-wf__spark ah-wf__spark--1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c.8 6.4 4.6 10.6 12 12-7.4 1.4-11.2 5.6-12 12-.8-6.4-4.6-10.6-12-12C7.4 10.6 11.2 6.4 12 0Z" fill="currentColor"/></svg></span>
      <span class="ah-wf__spark ah-wf__spark--2"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c.8 6.4 4.6 10.6 12 12-7.4 1.4-11.2 5.6-12 12-.8-6.4-4.6-10.6-12-12C7.4 10.6 11.2 6.4 12 0Z" fill="currentColor"/></svg></span>
      <span class="ah-wf__spark ah-wf__spark--3"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c.8 6.4 4.6 10.6 12 12-7.4 1.4-11.2 5.6-12 12-.8-6.4-4.6-10.6-12-12C7.4 10.6 11.2 6.4 12 0Z" fill="currentColor"/></svg></span>
    </div>

    <div class="ah-wf__tapes" aria-hidden="true">
      <div class="ah-wf__tape ah-wf__tape--a"><div class="ah-wf__tape-track" dir="ltr">
        {%- for i in (1..4) -%}
          <span>WHITE FRIDAY</span><i>✦</i><span>الجمعة البيضاء</span><i>✦</i><span dir="auto">{{ 'sections.mega_sale.strip_off' | t: percent: max_off }}</span><i>✦</i>
        {%- endfor -%}
      </div></div>
      <div class="ah-wf__tape ah-wf__tape--b"><div class="ah-wf__tape-track ah-wf__tape-track--rev" dir="ltr">
        {%- for i in (1..4) -%}
          <span dir="auto">{{ 'sections.mega_sale.tape_extended' | t }}</span><i>●</i><span dir="auto">{{ 'sections.mega_sale.until' | t }}</span><i>●</i><span dir="auto">{{ 'sections.mega_sale.perk_cod' | t }}</span><i>●</i>
        {%- endfor -%}
      </div></div>
    </div>

    <div class="container ah-1111__inner ah-wf__inner">
      <div class="ah-wf__copy">
        <span class="ah-wf__flag">{%- render 'icon', name: 'flag' -%}{{ 'sections.mega_sale.flag' | t }}</span>
        <h2 class="ah-wf__title"><span class="ah-wf__t1">{{ 'sections.mega_sale.title_a' | t }}</span><span class="ah-wf__t2">{{ 'sections.mega_sale.title_b' | t }}</span></h2>
        <p class="ah-wf__until">{%- render 'icon', name: 'clock' -%}<span>{{ 'sections.mega_sale.until' | t }}</span></p>
        <p class="ah-wf__sub">{{ 'sections.mega_sale.subtitle_html' | t: percent: max_off }}</p>
        <div class="ah-wf__ctas">
          <a href="{{ jump_discount }}" class="ah-btn ah-wf__btn"{% if section.settings.show_rails %} data-ah-jump{% endif %}>{{ 'sections.mega_sale.cta_discount' | t }}</a>
          <a href="{{ jump_cheapest }}" class="ah-btn ah-wf__btn ah-wf__btn--ghost"{% if section.settings.show_rails %} data-ah-jump{% endif %}>{{ 'sections.mega_sale.cta_cheapest' | t }}</a>
        </div>
        <ul class="ah-wf__perks" role="list">
          <li>{%- render 'icon', name: 'cash' -%}{{ 'sections.mega_sale.perk_cod' | t }}</li>
          <li>{%- render 'icon', name: 'truck' -%}{{ 'sections.mega_sale.perk_delivery' | t }}</li>
          <li>{%- render 'icon', name: 'return' -%}{{ 'sections.mega_sale.perk_returns' | t }}</li>
        </ul>
      </div>

      <div class="ah-wf__visual">
        <div class="ah-1111__badge ah-wf__badge" aria-hidden="true">
          <svg class="ah-1111__badge-ring" viewBox="0 0 120 120"><defs><path id="ah1111c-{{ section.id }}" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1 -92 0"/></defs><text><textPath href="#ah1111c-{{ section.id }}" textLength="288" lengthAdjust="spacingAndGlyphs">{{ 'sections.mega_sale.badge_ring' | t }}</textPath></text></svg>
          <span class="ah-1111__badge-core"><small>{{ 'sections.mega_sale.badge_up_to' | t }}</small><b dir="ltr">{{ max_off }}%</b><small>{{ 'sections.mega_sale.badge_off' | t }}</small></span>
        </div>
        <div class="ah-wf__tiles">
          {%- for h in pick_handles -%}
            {%- assign tp = all_products[h] -%}
            {%- if tp and tp.featured_image -%}
              {%- assign t_off = tp.compare_at_price | minus: tp.price | times: 100.0 | divided_by: tp.compare_at_price | round -%}
              <a href="{{ tp.url }}" class="ah-wf__tile ah-wf__tile--{{ forloop.index }}">
                {{ tp.featured_image | image_url: width: 360 | image_tag: loading: 'eager', widths: '180,270,360', sizes: '(min-width: 990px) 180px, 30vw', alt: tp.title }}
                <span class="ah-wf__tile-off" dir="ltr">−{{ t_off }}%</span>
                <span class="ah-wf__tile-price">{%- render 'money', cents: tp.price -%}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="ah-wf__clock" aria-live="off">
          <span class="ah-wf__clock-label">{%- render 'icon', name: 'clock' -%}{{ 'sections.mega_sale.ends_in' | t }}</span>
          <div class="ah-wf__units">
            <span class="ah-wf__unit"><b data-u="d">00</b><small>{{ 'sections.mega_sale.days' | t }}</small></span>
            <span class="ah-wf__unit"><b data-u="h">00</b><small>{{ 'sections.mega_sale.hours' | t }}</small></span>
            <span class="ah-wf__unit"><b data-u="m">00</b><small>{{ 'sections.mega_sale.minutes' | t }}</small></span>
            <span class="ah-wf__unit"><b data-u="s">00</b><small>{{ 'sections.mega_sale.seconds' | t }}</small></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- if section.settings.show_rails -%}
    <div class="ah-section ah-1111__rail" id="ah-1111-discounts-{{ section.id }}">
      <div class="container" data-rail>
        <div class="ah-section__head">
          <div>
            <span class="ah-eyebrow">{{ 'sections.mega_sale.rail_discount_eyebrow' | t }}</span>
            <h2 class="ah-section__title">{{ 'sections.mega_sale.rail_discount' | t }}</h2>
          </div>
          <div class="ah-section__head-end">
            <a href="{{ shop_url }}" class="ah-link-arrow">{{ 'sections.featured_collection.view_all' | t }}</a>
            <div class="ah-rail__nav">
              <button type="button" class="ah-rail__btn" data-rail-prev aria-label="{{ 'general.pagination.previous' | t }}">{%- render 'icon', name: 'chevron' -%}</button>
              <button type="button" class="ah-rail__btn" data-rail-next aria-label="{{ 'general.pagination.next' | t }}">{%- render 'icon', name: 'chevron' -%}</button>
            </div>
          </div>
        </div>
        <div class="ah-rail">
          <ul class="ah-rail__track" data-rail-track role="list">
            {%- comment -%} Sort by discount, highest first, independent of the collection's own sort order. {%- endcomment -%}
            {%- paginate coll.products by 100 -%}
              {%- liquid
                assign keyed = ''
                for p in coll.products
                  if p.available and p.compare_at_price > p.price
                    assign p_off = p.compare_at_price | minus: p.price | times: 1000 | divided_by: p.compare_at_price
                    assign key = p_off | plus: 1000
                    assign keyed = keyed | append: key | append: '|' | append: p.handle | append: ','
                  endif
                endfor
                assign by_off = keyed | split: ',' | sort | reverse
              -%}
              {%- for k in by_off limit: section.settings.product_count -%}
                {%- assign h = k | split: '|' | last -%}
                <li>{%- render 'product-card', product: all_products[h] -%}</li>
              {%- endfor -%}
            {%- endpaginate -%}
          </ul>
        </div>
      </div>
    </div>

    <div class="ah-section ah-section--surface ah-1111__rail" id="ah-1111-cheapest-{{ section.id }}">
      <div class="container" data-rail>
        <div class="ah-section__head">
          <div>
            <span class="ah-eyebrow">{{ 'sections.mega_sale.rail_price_eyebrow' | t }}</span>
            <h2 class="ah-section__title">{{ 'sections.mega_sale.rail_price' | t }}</h2>
          </div>
          <div class="ah-section__head-end">
            <a href="{{ cheap_url }}" class="ah-link-arrow">{{ 'sections.featured_collection.view_all' | t }}</a>
            <div class="ah-rail__nav">
              <button type="button" class="ah-rail__btn" data-rail-prev aria-label="{{ 'general.pagination.previous' | t }}">{%- render 'icon', name: 'chevron' -%}</button>
              <button type="button" class="ah-rail__btn" data-rail-next aria-label="{{ 'general.pagination.next' | t }}">{%- render 'icon', name: 'chevron' -%}</button>
            </div>
          </div>
        </div>
        <div class="ah-rail">
          <ul class="ah-rail__track" data-rail-track role="list">
            {%- paginate coll.products by 100 -%}
              {%- assign by_price = coll.products | where: 'available' | sort: 'price' -%}
              {%- for product in by_price limit: section.settings.product_count -%}
                <li>{%- render 'product-card', product: product -%}</li>
              {%- endfor -%}
            {%- endpaginate -%}
          </ul>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>
<script>
  (function () {
    var el = document.currentScript.previousElementSibling;
    if (!el || !el.hasAttribute('data-ah-mega')) return;
    var end = parseInt(el.getAttribute('data-end'), 10) * 1000;
    el.querySelectorAll('[data-ah-jump]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        var target = document.querySelector(a.getAttribute('href'));
        if (!target) return;
        e.preventDefault();
        var header = document.getElementById('shopify-section-header');
        var offset = header ? header.getBoundingClientRect().height : 0;
        var top = target.getBoundingClientRect().top + window.scrollY - offset - 8;
        var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: top, behavior: calm ? 'auto' : 'smooth' });
      });
    });
    var units = {};
    el.querySelectorAll('[data-u]').forEach(function (b) { units[b.getAttribute('data-u')] = b; });
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    function tick() {
      var left = Math.floor((end - Date.now()) / 1000);
      if (left <= 0) { el.hidden = true; return; }
      if (!units.d) { setTimeout(tick, 60000); return; }
      units.d.textContent = pad(Math.floor(left / 86400));
      units.h.textContent = pad(Math.floor(left % 86400 / 3600));
      units.m.textContent = pad(Math.floor(left % 3600 / 60));
      units.s.textContent = pad(left % 60);
      setTimeout(tick, 1000);
    }
    tick();
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "11.11 Mega Sale",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Sale collection", "info": "Use manual sort, highest discount first." },
    { "type": "text", "id": "start_ts", "label": "Start (Unix seconds)", "default": "1794258000", "info": "1794258000 = 10 Nov 2026 00:00 Riyadh" },
    { "type": "text", "id": "end_ts", "label": "End (Unix seconds)", "default": "1796072400", "info": "1796072400 = 1 Dec 2026 00:00 Riyadh (offer runs through 30 Nov)" },
    { "type": "image_picker", "id": "bg_image", "label": "Banner background photo" },
    { "type": "checkbox", "id": "show_hero", "label": "Show sale banner (hero + countdown)", "default": true },
    { "type": "checkbox", "id": "show_rails", "label": "Show product rails", "default": true },
    { "type": "range", "id": "product_count", "label": "Products per rail", "min": 4, "max": 24, "step": 1, "default": 16 }
  ],
  "presets": [{ "name": "11.11 Mega Sale" }]
}
{% endschema %}
