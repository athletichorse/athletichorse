{%- assign coll = collections[section.settings.collection] -%}
{%- if coll and coll.products_count > 0 -%}
{%- liquid
  assign max_off = 0
  if section.settings.background == 'sale'
    for p in coll.products limit: section.settings.product_count
      if p.compare_at_price > p.price
        assign p_off = p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price | round
        if p_off > max_off
          assign max_off = p_off
        endif
      endif
    endfor
  endif
-%}
<section class="ah-section{% if section.settings.background == 'surface' or section.settings.surface %} ah-section--surface{% elsif section.settings.background == 'dark' %} ah-section--dark ah-section--deals{% elsif section.settings.background == 'sale' %} ah-section--sale{% endif %}">
  <div class="container" data-rail>
    <div class="ah-section__head">
      <div>
        {%- if section.settings.background == 'sale' -%}
          <span class="ah-sale-flag">{%- render 'icon', name: 'sale' -%}{{ 'sections.sale_rail.flag' | t }}</span>
        {%- elsif section.settings.eyebrow != blank -%}<span class="ah-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="ah-section__title">
          {%- if section.settings.heading != blank -%}{{ section.settings.heading }}
          {%- elsif section.settings.title_preset != 'collection' -%}{{ 'sections.product_rail.' | append: section.settings.title_preset | t }}
          {%- else -%}{{ coll.title }}{%- endif -%}
        </h2>
        {%- if section.settings.text != blank -%}<p class="ah-section__desc">{{ section.settings.text }}</p>
        {%- elsif max_off > 0 -%}<p class="ah-section__desc ah-sale-sub">{{ 'sections.sale_rail.save_up_to' | t: percent: max_off }}</p>{%- endif -%}
      </div>
      <div class="ah-section__head-end">
        <a href="{{ coll.url }}" class="ah-link-arrow">{{ 'sections.featured_collection.view_all' | t }}</a>
        <div class="ah-rail__nav">
          <button type="button" class="ah-rail__btn" data-rail-prev aria-label="{{ 'general.pagination.previous' | t }}">{%- render 'icon', name: 'chevron' -%}</button>
          <button type="button" class="ah-rail__btn" data-rail-next aria-label="{{ 'general.pagination.next' | t }}">{%- render 'icon', name: 'chevron' -%}</button>
        </div>
      </div>
    </div>
    <div class="ah-rail">
      <ul class="ah-rail__track" data-rail-track role="list">
        {%- for product in coll.products limit: section.settings.product_count -%}
          <li>{%- render 'product-card', product: product -%}</li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>
{%- endif -%}


{% schema %}
{
  "name": "Product carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    {
      "type": "select", "id": "title_preset", "label": "Title",
      "options": [
        { "value": "collection", "label": "Collection title" },
        { "value": "new_arrivals", "label": "New arrivals (translated)" },
        { "value": "best_sellers", "label": "Best sellers (translated)" },
        { "value": "sale", "label": "On sale now (translated)" },
        { "value": "swimming", "label": "Swimming essentials (translated)" }
      ],
      "default": "collection"
    },
    { "type": "text", "id": "heading", "label": "Custom heading", "info": "Overrides the title above." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_count", "label": "Products to show", "min": 4, "max": 20, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "surface", "label": "Grey background (legacy)", "default": false },
    {
      "type": "select", "id": "background", "label": "Background",
      "options": [ { "value": "white", "label": "White" }, { "value": "surface", "label": "Light grey" }, { "value": "dark", "label": "Light green (deals)" }, { "value": "sale", "label": "Sale (red)" } ],
      "default": "white"
    }
  ],
  "presets": [{ "name": "Product carousel" }]
}
{% endschema %}
