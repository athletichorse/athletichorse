{%- assign coll = collections[section.settings.collection] -%}
{%- if coll and coll.products_count > 0 -%}
<section class="ah-section{% if section.settings.surface %} ah-section--surface{% endif %}">
  <div class="container" data-rail>
    <div class="ah-section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="ah-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="ah-section__title">{{ section.settings.heading | default: coll.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="ah-section__desc">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      <div class="ah-section__head-end">
        <a href="{{ coll.url }}" class="ah-link-arrow">{{ 'sections.featured_collection.view_all' | t }}</a>
        <div class="ah-rail__nav">
          <button type="button" class="ah-rail__btn" data-rail-prev aria-label="{{ 'general.pagination.previous' | t }}">{%- render 'icon', name: 'chevron' -%}</button>
          <button type="button" class="ah-rail__btn" data-rail-next aria-label="{{ 'general.pagination.next' | t }}">{%- render 'icon', name: 'chevron' -%}</button>
        </div>
      </div>
    </div>
    <div class="ah-rail">
      <ul class="ah-rail__track" data-rail-track role="list">
        {%- for product in coll.products limit: section.settings.product_count -%}
          <li>{%- render 'product-card', product: product -%}</li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>
{%- endif -%}


{% schema %}
{
  "name": "Product carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the collection title." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_count", "label": "Products to show", "min": 4, "max": 20, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "surface", "label": "Grey background", "default": false }
  ],
  "presets": [{ "name": "Product carousel" }]
}
{% endschema %}
