<div class="container">
  {%- render 'breadcrumbs', current: blog.title -%}
  <div class="ah-page-head ah-blog-head">
    <h1 class="ah-page-head__title">{{ blog.title }}</h1>
    <p class="ah-page-head__desc">{{ 'sections.blog.intro' | t }}</p>
  </div>

  {%- paginate blog.articles by 12 -%}
    {%- if blog.articles.size > 0 -%}
      <ul class="ah-blog-grid" role="list">
        {%- for article in blog.articles -%}
          <li>
            <a href="{{ article.url }}" class="ah-blog-card">
              <div class="ah-blog-card__media">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', alt: article.image.alt | default: article.title }}
                {%- endif -%}
              </div>
              <div class="ah-blog-card__body">
                <time class="ah-blog-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | time_tag: format: 'date' }}</time>
                <h2 class="ah-blog-card__title">{{ article.title }}</h2>
                {%- if article.excerpt != blank -%}<p class="ah-blog-card__excerpt">{{ article.excerpt | strip_html | truncate: 150 }}</p>{%- endif -%}
                <span class="ah-link-arrow">{{ 'sections.blog.read_more' | t }}</span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}
        <nav class="ah-blog-pages" aria-label="{{ blog.title | escape }}">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- else -%}
      <p class="ah-blog-empty">{{ 'sections.blog.empty' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
