{%- assign founded_year = section.settings.founded_year | default: 2025 -%}

<section class="ah-about-hero">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750,1100,1500,1800', sizes: '100vw', alt: '' }}
  {%- endif -%}
  <div class="container">
    <span class="ah-eyebrow ah-eyebrow--light">{{ 'sections.about.eyebrow' | t }}</span>
    <h1>{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'sections.about.heading' | t }}{% endif %}</h1>
    <p>{% if section.settings.intro != blank %}{{ section.settings.intro }}{% else %}{{ 'sections.about.intro' | t }}{% endif %}</p>
  </div>
</section>

<section class="ah-section">
  <div class="container">
    <div class="ah-story">
      <div class="ah-story__copy">
        <h2 class="ah-section__title">{{ 'sections.about.mission_heading' | t }}</h2>
        <p>{{ 'sections.about.mission_text' | t }}</p>
        <div class="ah-story__stats">
          <div class="ah-stat"><b>{{ founded_year }}</b><span>{{ 'sections.about.since_label' | t }}</span></div>
          <div class="ah-stat"><b>{{ section.settings.stat_products | default: '1000+' }}</b><span>{{ 'sections.story.stat_2' | t }}</span></div>
          <div class="ah-stat"><b>{{ 'sections.about.location_value' | t }}</b><span>{{ 'sections.about.location_label' | t }}</span></div>
        </div>
      </div>
      {%- if section.settings.image_2 != blank -%}
        <div class="ah-story__media">
          {{ section.settings.image_2 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: '' }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <section class="ah-section ah-section--surface">
    <div class="container">
      <div class="ah-section__head">
        <div>
          <h2 class="ah-section__title">{{ 'sections.about.gear_heading' | t }}</h2>
          <p class="ah-section__desc">{{ 'sections.about.gear_text' | t }}</p>
        </div>
      </div>
      <ul class="ah-sports" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign default_label = 'sections.about.gear_' | append: block.settings.icon | t
            assign gear_coll = collections[block.settings.collection]
          -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ gear_coll.url | default: routes.collections_url }}" class="ah-sports__item">
              <span class="ah-sports__icon" aria-hidden="true">{%- render 'icon', name: block.settings.icon -%}</span>
              <span class="ah-sports__label">{{ block.settings.label | default: default_label }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "About us",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero background image" },
    { "type": "image_picker", "id": "image_2", "label": "Mission image" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the translated default." },
    { "type": "textarea", "id": "intro", "label": "Intro text", "info": "Leave blank to use the translated default." },
    { "type": "number", "id": "founded_year", "label": "Founded year", "default": 2025 },
    { "type": "text", "id": "stat_products", "label": "Products stat", "default": "1000+" }
  ],
  "blocks": [
    {
      "type": "gear_item",
      "name": "Gear item",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "shirt", "label": "Shirt" },
            { "value": "shorts", "label": "Shorts" },
            { "value": "backpack", "label": "Backpack" },
            { "value": "medal", "label": "Medal" },
            { "value": "trophy", "label": "Trophy" },
            { "value": "flag", "label": "Flag" }
          ],
          "default": "shirt"
        },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "collection", "id": "collection", "label": "Linked collection" }
      ]
    }
  ],
  "presets": [{ "name": "About us" }]
}
{% endschema %}
